# ============================================
# Kra-tognoek Environment Variables
# ============================================
# Copy this file to .env and update with your values
# cp env.example .env

# ============================================
# MySQL Database Configuration
# ============================================
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=oj_system
MYSQL_USER=oj_user
MYSQL_PASSWORD=oj_password

# ============================================
# Redis Configuration
# ============================================
REDIS_QUEUE=job_queue

# ============================================
# S3 Service Configuration
# ============================================
# Bật/tắt việc vẽ bảng thống kê ra console
# true = bật (mặc định), false = tắt
S3_ENABLE_CONSOLE_OUTPUT=true

# Giới hạn số lần gọi trước khi reset counter
# Khi total_calls vượt quá giá trị này, total_row sẽ tăng và total_calls sẽ reset
S3_MAXCALL=100000000000000

# ============================================
# Server API Configuration
# ============================================
# Port cho Server API
PORT=5000

# JWT Secret Key - Phải có ít nhất 32 ký tự
# Dùng để sign và verify JWT tokens
JWT_SECRET=your-secret-key-change-in-production-min-32-chars

# Worker Secret Key - Phải có ít nhất 32 ký tự
# Dùng để xác thực callback từ Kra worker
# PHẢI GIỐNG với WORKER_SECRET trong Kra/.env
WORKER_SECRET=worker-secret-key-change-in-production-min-32-chars

# Server Base URL - URL của Server API
# Dùng cho callback từ Kra worker
SERVER_BASE_URL=http://localhost:5000

# S3 Base URL - URL của S3 service
# Dùng để upload/download files
S3_BASE_URL=http://s3:3001

# Resend API Key - Dùng để gửi email
# Lấy từ https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Frontend URL - URL của Client frontend
# Dùng trong email links
URL_FRONTEND_LOGIN=http://localhost:3000

# ============================================
# Firebase Public Configuration
# ============================================
# Dùng trong Client frontend để kết nối Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=xxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=xxxxxxxxxxx.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=xxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=xxxxxxxxxxx.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=xxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_APP_ID=1:xxxxxxxxxxx:web:xxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-xxxxxxxxxxx

# ============================================
# Ark Service Configuration (AI Moderation)
# ============================================
# OpenAI API Key - Dùng cho AI moderation
# Lấy từ https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# ============================================
# Client Frontend Configuration
# ============================================
# API Base URL - URL của Server API
# Client sẽ gọi API từ đây
NEXT_PUBLIC_API_BASE=http://localhost:5000

# ============================================
# Kra Service Configuration (Chạy bên ngoài Docker)
# ============================================
# Lưu ý: Kra chạy BÊN NGOÀI Docker (cần isolate)
# Các biến sau dùng cho Kra/.env (không dùng trong docker-compose.yml)
#
# REDIS_URL=redis://localhost:6379
# REDIS_QUEUE=job_queue
# S3_BASE_URL=http://localhost:3001
# KRA_WEB_PORT=4000
# WORKER_SECRET=worker-secret-key-change-in-production-min-32-chars
# UI=true (optional - bật Web UI)
# DEBUG=true (optional - bật debug logs)
# USE_ISOLATE=true (optional - dùng isolate sandbox)
